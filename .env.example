# Placeholders only — never real secrets.
# Copy secrets into .env.local. Public vars may live in .env.

# --- ElevenLabs (Conversational AI) -----------------------------------------
# Server-only → .env.local. NEVER prefix with NEXT_PUBLIC_.
XI_API_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Safe to expose (signed URL still required to connect).
NEXT_PUBLIC_AGENT_ID=agent_xxxxxxxxxxxxxxxxxxxxxxxxxxx

# Client sets overrides.tts.voiceId from this. Must be a voice that exists in
# YOUR workspace — a stale id fails at session start, not at build time.
NEXT_PUBLIC_XI_VOICE_ID=EXAVITQu4vr4xnSDxMaL

# --- Demo mode --------------------------------------------------------------
# "live" (default) or "demo". In demo, extraction serves the baked Whitfield
# bundle and drug lookup reads fixtures/nhs-drug-map.json — no AI Gateway call
# and no NHS.uk call. Everything else stays real, and the UI says it is on.
# A live failure NEVER falls through to demo; it 422s.
NEXT_PUBLIC_PORTICO_MODE=live

# --- Vercel AI Gateway (server-only → .env.local) ---------------------------
AI_GATEWAY_API_KEY=

# --- Vercel Blob (server-only → .env.local) ---------------------------------
BLOB_READ_WRITE_TOKEN=

# --- Upstash Redis (server-only → .env.local) -------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
